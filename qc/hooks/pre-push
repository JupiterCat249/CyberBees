#!/bin/sh
# pre-push —— 推送前必须"有当前 HEAD 的证据"（G4 批次2 · 迭代169）
# 顺序：跑全闸 → 写 receipt（绑定 HEAD + counts）→ 推送才有据可查
# 安装：powershell -File qc/install-hooks.ps1（core.hooksPath=qc/hooks 对 pre-commit/pre-push 同时生效）
powershell -NoProfile -ExecutionPolicy Bypass -File qc/qc.ps1 all || exit 1
powershell -NoProfile -ExecutionPolicy Bypass -File qc/qc.ps1 receipt || exit 1
exit 0
