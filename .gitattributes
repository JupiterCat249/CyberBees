# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Git LFS: godot-git-plugin native binaries (platform-specific, large)
addons/godot-git-plugin/**/*.dll filter=lfs diff=lfs merge=lfs -text
addons/godot-git-plugin/**/*.so filter=lfs diff=lfs merge=lfs -text
addons/godot-git-plugin/**/*.dylib filter=lfs diff=lfs merge=lfs -text
