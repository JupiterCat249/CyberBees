; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="电子蜂"
run/main_scene="res://scenes/battle_card.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
# 迭代024：**锁定 60fps** —— 动画系统按"帧数"计时（T2），其时长换算基准是 60fps；
#   此前未锁帧，实测跑到 ~165fps → "60 帧"实际只播 0.36s（飘字/抖动统统比配置短得多）。
run/max_fps=60

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dsh_godot/plugin.cfg", "res://addons/gd-plug-plus/plugin.cfg", "res://addons/godot-idea-board/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godot_with_u/plugin.cfg")

[godot_idea_board]

directory_path="res://addons/godot-idea-board/savedata/"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
